{
  "cli": {
    "version": ">= 18.0.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "LEDPOP_AD_PROFILE": "test",
        "EXPO_PUBLIC_WEB_AD_DIAGNOSTICS": "0"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "LEDPOP_AD_PROFILE": "test",
        "EXPO_PUBLIC_WEB_AD_DIAGNOSTICS": "0"
      }
    },
    "production": {
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1",
        "buildArtifactPaths": [
          "ios/build/*.dSYM.zip",
          "ios/build/*.xcarchive.zip",
          "ios/build/ios-verification.json",
          "ios/Podfile.lock"
        ]
      },
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "LEDPOP_AD_PROFILE": "production",
        "EXPO_PUBLIC_WEB_AD_DIAGNOSTICS": "0",
        "EXPO_PUBLIC_UMP_EEA_TEST_DEVICE": "disabled"
      }
    },
    "ipa-only": {
      "extends": "production",
      "distribution": "store",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_UMP_EEA_TEST_DEVICE": "disabled"
      },
      "credentialsSource": "local"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6749168042"
      }
    }
  }
}
