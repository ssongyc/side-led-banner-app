{
  "cli": {
    "version": ">= 18.0.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "LEDPOP_AD_PROFILE": "test",
        "EXPO_PUBLIC_WEB_AD_DIAGNOSTICS": "0"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "LEDPOP_AD_PROFILE": "test",
        "EXPO_PUBLIC_WEB_AD_DIAGNOSTICS": "0"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "LEDPOP_AD_PROFILE": "production",
        "EXPO_PUBLIC_WEB_AD_DIAGNOSTICS": "0"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6749168042"
      }
    }
  }
}
