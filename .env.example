EXPO_PUBLIC_AMPLITUDE_API_KEY=your_amplitude_api_key_here

# Google Play Console > Monetization setup > Licensing: Base64 RSA PUBLIC key.
# This public key is bundled in the app. Never put service-account/private keys here.
EXPO_PUBLIC_GOOGLE_PLAY_LICENSE_KEY=

# Native ad profile: production (local default) or test (Google demo IDs).
# EAS profiles and the local build wrapper set LEDPOP_AD_PROFILE explicitly.
# Do not set WEB diagnostics globally; use node scripts/start-web-ad-diagnostics.cjs.
