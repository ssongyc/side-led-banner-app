{
  "expo": {
    "name": "Led Pop",
    "slug": "led-banner-app",
    "version": "1.0.9",
    "orientation": "default",
    "icon": "./assets/images/Logo_IOS.png",
    "scheme": "sideledbannerapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "icon": "./assets/images/LOGO_05_Final.png",
      "bundleIdentifier": "com.minkyokim.sideledbannerapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/images/LOGO_05_Final.png",
      "predictiveBackGestureEnabled": false,
      "package": "com.minkyokim.sideledbannerapp",
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 27
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to set the banner background."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a1a1a",
          "image": "./assets/images/splash-transparent.png",
          "imageWidth": 1,
          "dark": {
            "backgroundColor": "#1a1a1a",
            "image": "./assets/images/splash-transparent.png"
          }
        }
      ],
      "expo-font",
      "expo-localization",
      [
        "expo-navigation-bar",
        {
          "hidden": true
        }
      ],
      [
